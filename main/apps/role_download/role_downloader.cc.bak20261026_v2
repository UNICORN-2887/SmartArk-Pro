static void start_download(int idx) {
    if (idx < 0 || idx >= (int)s_roles.size()) return;
    s_busy = true;
    s_quit = false;
    lv_obj_t *bar = s_progress;
    lv_bar_set_value(bar, 0, LV_ANIM_OFF);
