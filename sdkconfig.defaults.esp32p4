CONFIG_IDF_TARGET="esp32p4"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y

CONFIG_SPIRAM=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=10240
CONFIG_FREERTOS_HZ=1000
CONFIG_FREERTOS_VTASKLIST_INCLUDE_COREID=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y

CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=49152
CONFIG_SPIRAM_MEMTEST=n
CONFIG_MBEDTLS_EXTERNAL_MEM_ALLOC=y

CONFIG_SLAVE_IDF_TARGET_ESP32C6=y
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_ESP_HOSTED_MEMPOOL_PREFER_SPIRAM=y

CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=y

CONFIG_IDF_EXPERIMENTAL_FEATURES=y

# LVGL FATFS文件系统支持（用于从SD卡加载图片）
CONFIG_LV_USE_FS_FATFS=y
CONFIG_LV_FS_FATFS_LETTER=83
CONFIG_LV_FS_FATFS_CACHE_SIZE=0

# LVGL LODEPNG解码器支持（用于加载PNG图片）
CONFIG_LV_USE_LODEPNG=y

# ── 雷达 BLE(2026-10-26 持久化:sdkconfig 重生成曾丢 BT 配置导致 radar_ble.cc
#    编译失败 nimble/nimble_port.h 找不到)──
# 蓝牙控制器在 C6 协处理器(esp_hosted HCI over SDIO),P4 只跑 NimBLE 主机栈。
# 配置与 esp_hosted 官方示例 esp_hosted_nimble/bleprph_minimal/mcu_host 对齐
CONFIG_ESP_HOSTED_HOST_FEAT_BT=y
CONFIG_BT_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_BT_NIMBLE_42_FEATURE_SUPPORT=y
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n

# 雷达 ESP-NOW 数据通道(2026-10-26 持久化:同上,重生成曾丢,radar_esnow.cc
# 整个被 #if CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA 屏蔽 → 链接 undefined)
CONFIG_ESP_HOSTED_HOST_FEAT_PEER_DATA=y
